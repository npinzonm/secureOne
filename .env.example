# =============================================================================
# SecureOne — plantilla de variables de entorno.
# NO pongas valores reales aquí. Genera tu .env con:  ./scripts/init-env.sh
# El archivo .env está excluido de Git.
# =============================================================================

# Proyecto Compose (permite aislar dev/test/prod en el mismo equipo)
COMPOSE_PROJECT_NAME=secureone

# dev | test | prod
APP_ENV=prod
LOG_LEVEL=INFO

# Puerto publicado por Nginx en el host (único puerto expuesto)
HTTP_PORT=8080

# PostgreSQL
POSTGRES_DB=secureone
# Rol owner (superusuario de la imagen). Solo lo usan postgres y el servicio `migrate`.
POSTGRES_USER=secureone_owner
POSTGRES_PASSWORD=__GENERADO_POR_init-env.sh__
# Rol de runtime del backend (creado/actualizado por `migrate`; sin DDL ni DELETE por defecto).
APP_DB_USER=secureone_api
APP_DB_PASSWORD=__GENERADO_POR_init-env.sh__

# Redis
REDIS_PASSWORD=__GENERADO_POR_init-env.sh__

# Firma de access tokens JWT (HS256). Rotarla invalida todas las sesiones.
JWT_SECRET=__GENERADO_POR_init-env.sh__
# Cookie de refresh con atributo Secure (los navegadores lo aceptan en http://127.0.0.1).
REFRESH_COOKIE_SECURE=true

# Correo (PD-11): SMTP local Mailpit (UI en http://127.0.0.1:8025). Para un SMTP real,
# cambiar host/puerto/remitente y agregar SMTP_USER/SMTP_PASSWORD/SMTP_STARTTLS.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=secureone@localhost.test
